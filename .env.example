# ─── BAYHIFI CLOUD HOST CONFIGURATION ───
# Path to your local / network music directory on host:
MUSIC_HOST_DIR=/path/to/your/music

# Persistent SQLite Database & state storage path on host:
DATA_HOST_DIR=./docker_data

# Secret Key for JWT Authentication (generate a random secure secret):
JWT_SECRET=bayhifi_ultra_secure_secret_key_change_me_in_production

# Public Web Port (Frontend + Reverse Proxy):
PORT_WEB=8111
